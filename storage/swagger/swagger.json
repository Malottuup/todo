{
    "openapi": "3.0.0",
    "info": {
        "title": "Todo API",
        "description": "Простой API для задач",
        "version": "1.0.0"
    },
    "paths": {
        "/api/tasks": {
            "get": {
                "tags": [
                    "Tasks"
                ],
                "summary": "Получить список задач",
                "operationId": "77c5931b335186326f20959579ccebe4",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            },
            "post": {
                "tags": [
                    "Tasks"
                ],
                "summary": "Создать задачу",
                "operationId": "52f011e20d9172649594c8eb1dcafff0",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "task"
                                ],
                                "properties": {
                                    "task": {
                                        "type": "string",
                                        "example": "Купить хлеб"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Создано"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Tasks",
            "description": "Управление задачами"
        }
    ]
}